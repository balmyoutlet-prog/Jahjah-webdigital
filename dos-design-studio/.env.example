# DOS Design Studio — environment settings.
# Set these in the DOS Vercel project (Settings → Environment Variables), never in the main Jahjah Web Digital project.

# Canonical origin. Keep as-is for production.
NEXT_PUBLIC_SITE_URL=https://dos.jahjahwebdigital.com

# WhatsApp numbers in international format, digits only (country code first, no +, no spaces, no leading zeros).
# Example format only: 9613xxxxxx (Lebanon), 9665xxxxxxxx (Saudi Arabia), 9715xxxxxxxx (UAE), 974xxxxxxxx (Qatar).
# Defaults live in src/lib/site.ts (Shahinaz +961 70 684 195, Dima +961 81 405 269); these variables override them.
# Architecture, plans, facades, architectural coordination -> Shahinaz Jahjah
NEXT_PUBLIC_WA_ARCHITECTURE=
# Interior architecture, interior design, styling, materials, furniture -> Dima Jahjah
NEXT_PUBLIC_WA_INTERIORS=
# General inquiries. Leave empty to fall back to the interiors number.
NEXT_PUBLIC_WA_GENERAL=

# DOS-only Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics entirely.
# Must be a property created for DOS — never the Jahjah Web Digital property.
NEXT_PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token for dos.jahjahwebdigital.com (optional).
NEXT_PUBLIC_GSC_VERIFICATION=

# Shows the "Preview — pending approval" ribbon and pending-confirmation labels. Set to "false" only after sign-off.
NEXT_PUBLIC_PREVIEW_MODE=true
